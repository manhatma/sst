(version 1)

# R50 sitzt unter dem gesteckten Pico (Buchsenleisten 8,5 mm).
# Der Pico-Courtyard ueberdeckt ihn absichtlich.
(rule "Unter Pico: R50"
	(severity ignore)
	(constraint courtyard_clearance)
	(condition "(A.Reference == 'U1' && B.Reference == 'R50') || (A.Reference == 'R50' && B.Reference == 'U1')"))
